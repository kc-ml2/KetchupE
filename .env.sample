# .env.sample — 이 파일을 .env로 복사한 뒤 실제 값을 채우세요.
# .env는 .gitignore에 이미 포함되어 있어 커밋되지 않습니다.
# 앱 안에서도(설정 화면) 같은 값을 넣을 수 있습니다 — 여기 env 값은 설정 화면 값보다 우선합니다.

# ── LiteLLM (모델 gateway) ──────────────────────────────────────────
# 필수: 없으면 LiteLLM 관련 기능(agent 답변, bench:agent --client litellm, smoke:litellm)이 동작하지 않습니다.
LITELLM_API_KEY=
# 선택: 기본값은 electron/agent/modelClient.ts의 DEFAULT_LITELLM_BASE_URL (centinels.ml2-alpha.com)
LITELLM_BASE_URL=
# 선택: 비우면 gateway의 GET /models 첫 번째 모델을 자동으로 씁니다.
LITELLM_MODEL_ALIAS=

# ── Langfuse (opt-in trajectory 미러링 · 기본 꺼짐) ──────────────────
# 셋 다 있어야 전송이 켜집니다 (LANGFUSE_PUBLIC_KEY가 있으면 자동으로 enabled=true).
# https://cloud.langfuse.com 프로젝트 설정 > API Keys에서 발급.
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# 선택: Langfuse users 화면에 표시할 식별자. 비우면 익명 install id 사용.
KETCHUPE_USER_ID=
# 선택: policy A/B variant 강제 지정 (always-search-v1 | adaptive-v1). 비우면 install id 기준 결정적 자동 배정.
KETCHUPE_VARIANT=

# ── Tomato (로컬 검색 엔진) ───────────────────────────────────────────
# 선택: multilingual-e5-small 임베딩 가중치 캐시 경로. 비우면 <home>/models.
TOMATO_MODEL_CACHE=

# ── 그 외 (v2 / 기존 도구, v3 agent와 무관) ───────────────────────────
VITE_API_URL=
NOTION_TOKEN=
NOTION_FCN_DATABASE_ID=
NOTION_COMMIT_DATABASE_ID=
NOTION_SCN_DATABASE_ID=
