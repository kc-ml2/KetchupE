{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ketchupe.ai/schemas/trajectory-v2.json",
  "title": "KetchupE central trajectory envelope",
  "type": "object",
  "required": ["schemaVersion", "traceId", "traceName", "observations"],
  "properties": {
    "schemaVersion": { "const": "ketchupe-trajectory-v2" },
    "traceId": { "type": "string", "minLength": 1 },
    "traceName": { "enum": ["agent.run", "index.sync", "app.session"] },
    "release": { "type": ["string", "null"] },
    "environment": { "type": ["string", "null"] },
    "sessionId": { "type": ["string", "null"] },
    "observations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "traceId", "type", "startTime"],
        "properties": {
          "id": { "type": "string" },
          "traceId": { "type": "string" },
          "parentObservationId": { "type": ["string", "null"] },
          "name": { "type": ["string", "null"] },
          "type": { "type": "string" },
          "startTime": { "type": "string", "format": "date-time" },
          "endTime": { "type": ["string", "null"], "format": "date-time" },
          "input": {},
          "output": {},
          "metadata": { "type": ["object", "null"] }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
